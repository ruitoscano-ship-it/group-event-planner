{
  "name": "round-gatherings",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "round-dot.com", "custom_domain": true },
    { "pattern": "www.round-dot.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "round-db",
      "database_id": "e8c77b53-91ab-4b9c-a38d-613c74b2cf0e",
      "migrations_dir": "migrations"
    }
  ]
}
