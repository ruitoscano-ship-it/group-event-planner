# Copy to .dev.vars for local `wrangler dev`
# Production: wrangler secret put ADMIN_PASSWORD
ADMIN_PASSWORD=change-me-to-a-long-secret

# Google organizer sign-in (optional — without these, code-only mode still works)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ORGANIZER_SESSION_SECRET=change-me-to-a-long-random-secret
